# Copy this file to .env and fill in your values
# Never commit .env — it is gitignored

# Database
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/safedrive_dev

# API
API_TITLE=SafeDrive AI Backend
API_VERSION=1.0.0

# AWS S3 (set USE_S3=false to use local storage during development)
USE_S3=false
S3_BUCKET_NAME=safedrive-videos-dev
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-east-1

# JWT (change this to a long random string in production)
JWT_SECRET=change-this-to-a-long-random-secret-in-production

# Twilio (SMS alerts to trusted contacts). Leave blank to run in dry-run mode,
# which logs the message instead of sending it — useful for local dev/CI.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
