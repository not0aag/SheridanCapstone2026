# ML Artifacts - Training Files (Large, Regenerable)
/models/
/logs/
*.pyc
*.pyo

# ML Models - Keep only small production models
# Large training models (.h5, .keras) should not be committed
ml-models/*/models/*.h5
ml-models/*/models/*.keras
ml-models/week*/models/
!ml-models/week*/models/.gitkeep

# ML Training Logs & Cache
ml-models/*/logs/
ml-models/*/*.log
ml-models/*/__pycache__/
ml-models/*/*/__pycache__/

# Keep only production-ready models (TFLite, Core ML)
# These are small and deployment-ready
!ml-models/*/tflite_models/*.tflite
!ml-models/*/tflite_models/*.mlmodel
!ml-models/*/tflite_models/*.md
!ml-models/*/tflite_models/*.json

